# Example configuration only.
# Copy this file to backend/.env for local development.
# Never add real passwords or API keys to GitHub.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Used when GROQ_API_KEY is not configured
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

SERVICEDESK_USERNAME=servicedesk
SERVICEDESK_PASSWORD=replace-with-a-strong-password

ENGINEER_USERNAME=engineer
ENGINEER_PASSWORD=replace-with-a-strong-password
